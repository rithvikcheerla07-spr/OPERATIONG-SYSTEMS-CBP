{
  "name": "os-execution-replay-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:engine": "make -C engine || echo 'Skipping C engine compilation'",
    "build:client": "vite build",
    "build": "(make -C engine || echo 'Skipping C engine compilation') && vite build",
    "start": "node server.ts",
    "dev": "tsx server.ts",
    "dev:server": "PORT=3001 tsx server/index.ts",
    "dev:client": "vite --port=3000 --host=0.0.0.0",
    "test:engine": "make -C engine test",
    "test:server": "tsx --test server/tests/server.test.ts",
    "test": "(make -C engine test || echo 'Skipping C engine tests') && tsx --test server/tests/server.test.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js && (make -C engine clean || true)",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
